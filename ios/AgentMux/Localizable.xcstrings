      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Open the hub's Console on a computer and show the phone link, then scan its QR code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开 Hub 的 Console，显示手机连接二维码，然后扫码。"
          }
        }
      }
    },
    "Or paste the link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或粘贴链接"
          }
        }
      }
    },
    "Password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码"
          }
        }
      }
    },

{
  "description": "Additive, fail-open AgentMux observability hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentmux/bin/agentmux-hook\" || \"$HOME/.agentmux/bin/agentmux-hook\" --source codex",
            "timeout": 1
          }
        ]
      }
    ]
  }
}

{
  "description": "Additive, fail-open AgentNexus observability hooks for Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -x \"$HOME/.agentnexus/bin/agentnexus-hook\" || \"$HOME/.agentnexus/bin/agentnexus-hook\" --source claude",
            "timeout": 1
          }
        ]
      }
    ]
  }
}

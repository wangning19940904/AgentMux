+def doubao_local_proxy() -> str | None:
+    """Explicitly opt into the user's local proxy without trusting global env."""
+    value = os.getenv("DOUBAO_HTTPS_PROXY", "").strip()
+    if not value:
+        return None
+    parsed = urlsplit(value)
+    if (
+        parsed.scheme not in {"http", "https"}
+        or parsed.hostname not in {"127.0.0.1", "localhost", "::1"}
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path not in {"", "/"}
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError("DOUBAO_HTTPS_PROXY must be a loopback HTTP(S) proxy URL.")
+    return value
+

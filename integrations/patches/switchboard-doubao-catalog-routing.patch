--- /dev/null
+++ b/tests/unit/test_agentmux_doubao_catalog.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+import asyncio
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from codex_provider_switchboard.application.inspector import RequestInspector
+from codex_provider_switchboard.infrastructure.config_store import ConfigStore
+from codex_provider_switchboard.infrastructure.direct_client import DirectAPIError
+from codex_provider_switchboard.infrastructure.doubao_http import doubao_local_proxy
+from codex_provider_switchboard.providers.direct import DirectProvider
+from codex_provider_switchboard.runtime import build_runtime
+from codex_provider_switchboard.settings import AppSettings
+from codex_provider_switchboard.web.app import create_app
+
+MODELS = ("gpt-6.1-sol", "orange-5.5", "gpt-6-astra")
+
+
+def events(raw):
+    return [
+        json.loads(line[6:])
+        for line in raw.decode().splitlines()
+        if line.startswith("data: ")
+    ]
+
+
+def configure(store):
+    store.update_from_api(
+        {
+            "active_provider": "direct",
+            "direct": {
+                "platform_id": "doubao_work",
+                "model_id": MODELS[0],
+            },
+        }
+    )
+
+
+def test_catalog_exposes_account_models_and_does_not_fall_back_on_failure(tmp_path):
+    async def scenario():
+        runtime = build_runtime(
+            settings=AppSettings.from_env(),
+            config_path=tmp_path / "config.json",
+            codex_config_path=tmp_path / "codex.toml",
+        )
+        configure(runtime.store)
+        fail = False
+
+        async def catalog(platform_id=None, *, force=False):
+            assert platform_id == "doubao_work"
+            if fail:
+                raise httpx.ConnectError("network down")
+            return [
+                {"id": model, "displayName": model, "contextWindowTokens": 1000000}
+                for model in MODELS
+            ]
+
+        runtime.direct_client.get_models = catalog
+        async with httpx.AsyncClient(
+            transport=httpx.ASGITransport(app=create_app(runtime)),
+            base_url="http://127.0.0.1",
+        ) as client:
+            response = await client.get("/v1/models")
+            assert response.status_code == 200
+            assert [row["id"] for row in response.json()["data"]] == list(MODELS)
+            assert response.json()["data"][1]["context_window"] == 1000000
+            fail = True
+            response = await client.get("/v1/models")
+            assert response.status_code == 502
+            assert "data" not in response.json()
+            assert runtime.store.read()["direct"]["model_id"] == MODELS[0]
+
+    asyncio.run(scenario())
+
+
+def test_doubao_routes_concurrent_requests_by_model_without_changing_default(tmp_path):
+    store = ConfigStore(tmp_path / "config.json")
+    configure(store)
+    selected = {}
+
+    class Native:
+        async def run(self, body, model, timeout_seconds, *, progress):
+            selected[body["input"]] = model
+            await asyncio.sleep(0)
+            if model not in MODELS:
+                raise DirectAPIError("Unknown account model")
+            return {"text": model, "items": [], "complete": True}
+
+    inspector = RequestInspector()
+    provider = DirectProvider(store, SimpleNamespace(doubao_work=Native()), inspector)
+
+    async def request(model, identity):
+        body = {"input": identity}
+        if model is not None:
+            body["model"] = model
+        raw = b"".join([chunk async for chunk in provider.stream(body)])
+        return events(raw)
+
+    async def scenario():
+        results = await asyncio.gather(*(request(model, model) for model in MODELS))
+        for model, result in zip(MODELS, results, strict=True):
+            assert result[-1]["type"] == "response.completed"
+            assert result[-1]["response"]["model"] == model
+            assert selected[model] == model
+        result = await request(None, "default")
+        assert selected["default"] == MODELS[0]
+        assert result[-1]["type"] == "response.completed"
+        result = await request("unknown", "unknown")
+        assert selected["unknown"] == "unknown"
+        assert result[-1]["type"] == "response.failed"
+        assert not any(event["type"] == "response.completed" for event in result)
+        assert store.read()["direct"]["model_id"] == MODELS[0]
+
+    asyncio.run(scenario())
+
+
+def test_explicit_local_proxy_keeps_environment_disabled(monkeypatch):
+    monkeypatch.delenv("DOUBAO_HTTPS_PROXY", raising=False)
+    assert doubao_local_proxy() is None
+    monkeypatch.setenv("DOUBAO_HTTPS_PROXY", "http://127.0.0.1:7897")
+    assert doubao_local_proxy() == "http://127.0.0.1:7897"
+    for invalid in (
+        "http://example.com:7897",
+        "http://user:secret@127.0.0.1:7897",
+        "http://127.0.0.1:7897?key=secret",
+    ):
+        monkeypatch.setenv("DOUBAO_HTTPS_PROXY", invalid)
+        with pytest.raises(ValueError):
+            doubao_local_proxy()

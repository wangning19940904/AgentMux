{
  "name": "agentmux-sdk",
  "version": "0.1.5-dev.0",
  "description": "Official TypeScript SDK for the AgentMux control plane (health, invocations, management, console sessions).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangning19940904/AgentMux.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "agentmux",
    "agents",
    "sdk"
  ]
}
